{
  "manifest_version": 3,
  "name": "RealView — AI Media Detector",
  "version": "0.1.0",
  "description": "Detect, label, and filter likely AI-generated text, images, and video. Analysis runs locally on visible page content.",
  "permissions": ["storage", "activeTab", "scripting", "offscreen"],
  "host_permissions": ["<all_urls>"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "action": {
    "default_title": "RealView",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "run_at": "document_idle",
      "all_frames": false,
      "css": ["src/content.css"],
      "js": [
        "src/settings.js",
        "src/detect/signals.js",
        "src/detect/pixels.js",
        "src/detect/text.js",
        "src/detect/local-text.js",
        "src/detect/local-image.js",
        "src/detect/image.js",
        "src/detect/video.js",
        "src/presentation.js",
        "src/content.js"
      ]
    }
  ]
}
